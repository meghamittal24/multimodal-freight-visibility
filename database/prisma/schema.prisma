// Prisma Schema for Unified Multimodal Freight Visibility Platform
// SIH 2026 - Jugaad Junction

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SHIPPER
  TRANSPORTER
  PORT_OPERATOR
  ADMIN
}

enum TransportMode {
  ROAD
  RAIL
  PORT
  VESSEL
  WAREHOUSE
}

enum ShipmentStatus {
  CREATED
  IN_TRANSIT
  AT_HANDOFF
  DELAYED
  DELIVERED
  HELD
  REROUTED
}

enum LegStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
  HELD
  SKIPPED
}

enum DataSource {
  FOIS
  FASTAG
  PCS1X
  ICEGATE
  VAHAN
  IOT_TELEMETRY
  MOCK
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SuggestedActionType {
  PROCEED
  HOLD
  REROUTE
  RESCHEDULE
  ALERT_STAKEHOLDERS
}

model Corridor {
  id                  String     @id @default(uuid())
  code                String     @unique
  name                String
  origin              String
  destination         String
  primaryModes        String[]   @default(["ROAD", "RAIL", "PORT"])
  distanceKm          Float
  averageTransitHours Float
  dfcConnected        Boolean    @default(false)
  active              Boolean    @default(true)
  shipments           Shipment[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@map("corridors")
}

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           UserRole   @default(SHIPPER)
  organization   String
  corridorAccess String[]   @default(["ALL"])
  phone          String?
  shipments      Shipment[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("users")
}

model Shipment {
  id                       String               @id @default(uuid())
  trackingNumber           String               @unique
  consignmentTitle         String
  commodityType            String
  isPerishable             Boolean              @default(false)
  targetTemperatureCelsius Float?
  shipperId                String?
  shipper                  User?                @relation(fields: [shipperId], references: [id])
  corridorId               String?
  corridor                 Corridor?            @relation(fields: [corridorId], references: [id])
  origin                   String
  destination              String
  currentMode              TransportMode        @default(ROAD)
  status                   ShipmentStatus       @default(IN_TRANSIT)
  cargoWeightTons          Float
  containerNumber          String?
  totalPlannedHours        Float
  cumulativeDelayMinutes   Int                  @default(0)
  carbonEstimateKg         Float?
  legs                     Leg[]
  trackingEvents           TrackingEvent[]
  coordinationAlerts       CoordinationAlert[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@map("shipments")
}

model Leg {
  id                        String            @id @default(uuid())
  shipmentId                String
  shipment                  Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sequenceOrder             Int
  mode                      TransportMode
  fromNode                  String
  toNode                    String
  plannedStart              DateTime
  plannedEnd                DateTime
  actualStart               DateTime?
  actualEnd                 DateTime?
  delayMinutes              Int               @default(0)
  status                    LegStatus         @default(PLANNED)
  source                    DataSource        @default(MOCK)
  assetId                   String?
  currentLat                Float?
  currentLng                Float?
  temperatureReadingCelsius Float?
  lastTelemetryPing         DateTime?
  predictions               DelayPrediction[]
  trackingEvents            TrackingEvent[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@unique([shipmentId, sequenceOrder])
  @@map("legs")
}

model DelayPrediction {
  id                    String              @id @default(uuid())
  legId                 String
  leg                   Leg                 @relation(fields: [legId], references: [id], onDelete: Cascade)
  riskScore             Float
  riskLabel             RiskLevel
  expectedDelayMinutes  Int
  suggestedAction       SuggestedActionType @default(PROCEED)
  plainLanguageReason   String
  featureAttributions   Json?
  modelVersion          String              @default("xgboost-v1.4.2")
  actionExecuted        Boolean             @default(false)
  coordinationAlerts    CoordinationAlert[]
  predictedAt           DateTime            @default(now())

  @@map("delay_predictions")
}

model TrackingEvent {
  id             String     @id @default(uuid())
  shipmentId     String
  shipment       Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  legId          String?
  leg            Leg?       @relation(fields: [legId], references: [id])
  source         DataSource
  eventName      String
  locationName   String
  latitude       Float?
  longitude      Float?
  eventTimestamp DateTime   @default(now())
  rawPayload     Json?
  createdAt      DateTime   @default(now())

  @@map("tracking_events")
}

model CoordinationAlert {
  id                String              @id @default(uuid())
  shipmentId        String
  shipment          Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  predictionId      String?
  prediction        DelayPrediction?    @relation(fields: [predictionId], references: [id])
  alertType         String
  severity          RiskLevel
  title             String
  message           String
  recommendedAction SuggestedActionType
  actionTaken       SuggestedActionType?
  acknowledged      Boolean             @default(false)
  createdAt         DateTime            @default(now())

  @@map("coordination_alerts")
}
